# copy to .env — never commit .env
ISO=CAISO                               # CAISO | ERCOT | PJM (PJM needs PJM_API_KEY)
LOCATION=TH_SP15_GEN-APND
PJM_API_KEY=                            # free at dataminer2.pjm.com; leave empty to hide PJM
FLEET_TOKEN=                            # any long random string; laptops pass it with --token (fleet/README.md)
OPERATOR_TOKEN=                         # devices other than this Mac join with it (make qr); empty: runs/.operator_token
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_PARALLEL=4                   # Ollama server setting; must be >= chat max_concurrency (jobs.yaml)
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://192.168.1.10:8080     # what the judge's phone opens

# agent model (one of)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AZURE_AI_PROJECT_ENDPOINT=              # set to route via Microsoft Agent Framework + Foundry
AZURE_MODEL_DEPLOYMENT=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Fetch.ai / ASI:One read-only agent (make fetch-agent, docs/fetch-agent.md)
AGENTVERSE_API_KEY=                     # agentverse.ai, profile menu, API Keys
FETCH_AGENT_SEED=                       # fixes the agent's address; printf 'FETCH_AGENT_SEED=%s\n' "$(openssl rand -hex 32)" >> .env
FETCH_AGENT_PORT=8001                   # the agent's local Inspector port (loopback only); not 8080 or 8090
